# ── 저장소 (없으면 이벤트/신청이 콘솔 로그로만 남음 — 로컬 개발은 비워도 됨)
# Neon/Supabase/RDS/로컬 PostgreSQL 모두 호환. 본 서비스(mio_server) DB와 분리할 것.
DATABASE_URL=

# ── 배포 도메인 (OG/공유 URL 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── B(link) variant 직행 도착지. TestFlight/스토어/디스코드 등.
# 비워두면 fake door로 동작: 클릭 수요만 측정하고 "정원 마감" 폴백 폼을 보여준다.
NEXT_PUBLIC_BETA_LINK_URL=

# ── /admin?token=… 통계 페이지 접근 토큰 (비우면 통계 페이지 비활성)
ADMIN_TOKEN=
