# Server-only. Generate two distinct values with: openssl rand -hex 32
# Never prefix these with NEXT_PUBLIC_ and never paste keys into a URL.
MIO_ADMIN_ACCESS_KEY=
MIO_ADMIN_SESSION_SECRET=
# Set to the exact external HTTPS origin on deployment, without a trailing slash.
# Example: https://your-team-host.example
MIO_ADMIN_ORIGIN=
# Browser origin for /v1 requests. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCK_API=false
