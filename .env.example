# Server-only. Never prefix these with NEXT_PUBLIC_ and never paste keys into a URL.
# Each value must be a 64-character hex string (minimum length 32). The two values must differ.
# Generate each value separately with: openssl rand -hex 32
MIO_ADMIN_ACCESS_KEY=
MIO_ADMIN_SESSION_SECRET=
# Set to the exact external HTTPS origin on deployment, without a trailing slash.
# Example: https://your-team-host.example
MIO_ADMIN_ORIGIN=
# API base URL for /v1 requests. No trailing slash.
# Example: https://api.example.test
NEXT_PUBLIC_API_BASE_URL=https://api-fakedoor.mio.io.kr
NEXT_PUBLIC_USE_MOCK_API=false
# MIO_ADMIN_ACCESS_KEY is the shared admin key (openssl rand -hex 32), not a SHA-256 digest.
# Operators type this value at login. The browser keeps it for the tab and sends it unchanged as
# Authorization: Bearer on /v1/admin/**. The API server stores only SHA-256 of this key
# (ADMIN_API_KEY_SHA256) and hashes the bearer itself. Do not paste that digest into this variable.
